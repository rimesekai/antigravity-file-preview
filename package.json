{
  "name": "file-preview",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "description": "Antigravity 侧边栏 PPT / Word / Excel / PDF / MP4 / HTML 文件预览插件",
  "author": "rimesekai <353441533+rimesekai@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/rimesekai/antigravity-file-preview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimesekai/antigravity-file-preview.git"
  },
  "bugs": {
    "url": "https://github.com/rimesekai/antigravity-file-preview/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "antigravity",
    "file-preview",
    "sidebar",
    "pptx",
    "docx",
    "xlsx",
    "pdf",
    "mp4",
    "html"
  ],
  "scripts": {
    "build:ui": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:ui && npm run build:server",
    "test": "node --test tests/server.test.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.4.0",
    "docx-preview": "^0.4.1",
    "pdfjs-dist": "3.11.174",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@aiden0z/pptx-renderer": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
